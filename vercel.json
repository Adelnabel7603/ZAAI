{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://zaai-production.up.railway.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://zaai-production.up.railway.app/uploads/$1" },
    { "source": "/admin", "destination": "https://zaai-production.up.railway.app/admin" },
    { "source": "/admin/", "destination": "https://zaai-production.up.railway.app/admin/" },
    { "source": "/admin/(.*)", "destination": "https://zaai-production.up.railway.app/admin/$1" }
  ]
}